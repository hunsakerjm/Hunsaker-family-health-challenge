{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "outDir": "node_modules/.tsbuild-node",
    "tsBuildInfoFile": "node_modules/.tsbuild-node/tsconfig.node.tsbuildinfo",
    "resolveJsonModule": true
  },
  "include": [
    "vite.config.ts",
    "package.json"
  ]
}
